{
  "name": "163-mail-minimal",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-focused Apple Mail-inspired UI cleanup extension for NetEase 163 Mail.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/validate-manifest.mjs && node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.292",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}

{
  "manifest_version": 3,
  "name": "163 Mail Minimal",
  "version": "1.2.0",
  "description": "Privacy-focused cleanup and a calm Apple Mail-inspired interface for NetEase 163 Mail.",
  "permissions": ["storage", "geolocation"],
  "host_permissions": ["https://mail.163.com/*", "https://geocoding-api.open-meteo.com/*", "https://api.open-meteo.com/*"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "action": {
    "default_title": "163 Mail Minimal",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["https://mail.163.com/*"],
      "css": ["assets/content.css"],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ]
}
